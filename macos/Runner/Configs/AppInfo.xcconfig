// Application-level settings for the Runner target (the Mac app).

// The application's name. By default this is also the title of the window.
PRODUCT_NAME = ONO

// The same bundle identifier as the iPhone app, so the Mac app is the same
// App Store product and signs in to the same account.
PRODUCT_BUNDLE_IDENTIFIER = com.eminhuseynzade.ono

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Emin Huseynzade. All rights reserved.
